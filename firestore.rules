rules_version = '2';

// Family log: each Firebase account owns families/{uid}/events. Append-only, no page text.
service cloud.firestore {
  match /databases/{database}/documents {
    match /families/{uid}/events/{eventId} {
      allow read: if request.auth != null && request.auth.uid == uid;

      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['ts', 'host', 'verdict', 'category', 'engine', 'reason', 'createdAt'])
        && request.resource.data.ts is number
        && request.resource.data.host is string && request.resource.data.host.size() <= 253
        && request.resource.data.verdict in ['block', 'warn']
        && request.resource.data.category is string && request.resource.data.category.size() <= 20
        && request.resource.data.engine in ['on-device', 'cloud', 'keywords']
        && request.resource.data.reason is string && request.resource.data.reason.size() <= 220
        && request.resource.data.createdAt == request.time;

      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
