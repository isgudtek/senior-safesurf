{
    "manifest_version": 3,
    "name": "__MSG_extName__",
    "description": "__MSG_extDesc__",
    "default_locale": "en",
    "version": "2.0.2",
    "key": "",
    "permissions": [
        "storage",
        "declarativeNetRequest",
        "activeTab",
        "offscreen",
        "scripting"
    ],
    "host_permissions": [
        "<all_urls>"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "icons": {
        "16": "icons/icon16.png",
        "32": "icons/icon32.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "action": {
        "default_popup": "popup.html",
        "default_icon": "icons/icon16.png"
    },
    "options_ui": {
        "page": "options.html",
        "open_in_tab": true
    },
    "web_accessible_resources": [
        {
            "resources": [
                "blocked.html",
                "blocked.js",
                "js/security.js"
            ],
            "matches": [
                "<all_urls>"
            ]
        }
    ],
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "js/keywords.js",
                "js/snapshot.js",
                "senior_overlay.js",
                "content_filter.js",
                "spa_sentinel.js"
            ],
            "css": [],
            "run_at": "document_start"
        }
    ],
    "minimum_chrome_version": "138"
}
